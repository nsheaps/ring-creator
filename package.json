{
  "name": "ring-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design an engagement ring and a matching wedding band in 3D, from data-driven component models.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate-models.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "e2e": "tsx e2e/app.e2e.ts",
    "catalog:build": "tsx scripts/build-examples.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jspdf": "2.5.2",
    "marked": "14.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "playwright": "1.49.1",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
